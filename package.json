{
  "name": "convert-api-specs-to-html",
  "version": "2.0.0",
  "description": "Render OpenAPI and AsyncAPI descriptions as plain HTML pages: no scripts, no inline styles, nothing from other hosts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flriancu/convert_api_specs_to_html.git"
  },
  "type": "module",
  "bin": {
    "convert-api-specs-to-html": "build.mjs"
  },
  "files": [
    "build.mjs",
    "check_page.mjs",
    "convert.mjs",
    "page.css",
    "page.mjs",
    "redocly.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "examples:lint": "redocly lint examples/notes.openapi.yaml examples/notes.asyncapi.yaml"
  },
  "dependencies": {
    "@redocly/cli": "2.71.1",
    "@scalar/asyncapi-to-markdown": "0.2.2",
    "@scalar/openapi-to-markdown": "1.7.0",
    "marked": "18.1.2"
  }
}
